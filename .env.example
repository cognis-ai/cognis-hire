NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_LIVE_URL=localhost:3000
FOLOUP_PUBLIC_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Retell AI
RETELL_API_KEY=

# Cognis LLM gateway (replaces OPENAI_API_KEY — all chat completions
# now flow through Bridge's LiteLLM proxy at llm.cognisai.com).
COGNIS_LITELLM_URL=https://llm.cognisai.com
COGNIS_LITELLM_KEY=

# Cognis admin shared secret — used by Bridge to call /api/admin/*, as the
# HMAC key for SSO handoff JWTs, and to sign the X-Cognis-Signature header
# on the voice-webhook forward to Bridge /hire/webhook.
FOLOUP_ADMIN_SHARED_SECRET=

# Voice-bot webhook glue: where Bridge lives (forward target) and the
# shared secret the Pipecat sidecar signs /api/voice-webhook posts with.
BRIDGE_PUBLIC_URL=
VOICE_BOT_SHARED_SECRET=

# Cognis branding overrides (optional). NEXT_PUBLIC_* values are inlined at
# BUILD time — for container builds pass them as build args (Dockerfile.cognis).
# OG scrapers don't render SVG: set THUMBNAIL_URL=/brand-assets/cognis-og.png
# (1200x630 PNG) for production link previews.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT_NAME=
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_LOGO_DARK_URL=
NEXT_PUBLIC_BRAND_THUMBNAIL_URL=
NEXT_PUBLIC_BRAND_PRIMARY=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=
NEXT_PUBLIC_BRAND_MARKETING_URL=

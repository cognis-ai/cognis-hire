# Cognis-managed Dockerfile for cognis-hire (FoloUp fork). Wraps the upstream
# build because upstream `Dockerfile` only copies package.json + yarn.lock at
# the deps stage, but the FoloUp `postinstall` script runs `prisma generate`
# which needs `prisma/schema.prisma` — the upstream build fails on a clean
# context. This wrapper copies the schema first so postinstall succeeds.
#
# Same multi-stage shape as upstream, just with the prisma fix and a few
# Cognis-specific tweaks:
#   - NODE_ENV defaulted at the runner stage (upstream sets it but leaves
#     PORT unset — we pin :3000 since compose remaps externally).
#   - HOSTNAME=0.0.0.0 so Next dev/start binds outside the container.

FROM node:23-alpine AS base
WORKDIR /app

# deps stage — install Node packages with prisma schema available for postinstall
FROM base AS deps
COPY package.json yarn.lock ./
COPY prisma ./prisma
RUN yarn install --frozen-lockfile

# builder stage — copy app source and produce a .next build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN yarn build

# runner stage — minimal image with only what production needs
FROM base AS runner
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
USER nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

EXPOSE 3000
CMD ["yarn", "start"]
